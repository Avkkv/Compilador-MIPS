digraph AFD {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", shape=circle, fixedsize=false];
    edge [fontname="Helvetica", fontsize=10];

    /* seta de entrada apontando para o estado inicial */
    inicio [shape=point];
    inicio -> q0;

    /* estados finais (de aceitacao) em doublecircle */
    node [shape=doublecircle];
    qID_FIM; qDIR_FIM; qREG_FIM; qNUM_FIM; qHEX_FIM;
    qSTR_FIM; qCOM_FIM; qCOL_FIM; qOPA_FIM; qCPA_FIM;
    qERRO; qERRO_STR_LINHA; qERRO_STR_EOF; qEOF;

    node [shape=circle];

    /* ===================== estado inicial ===================== */
    q0 [label="q0\n(inicial)"];
    q0 -> q0 [label="espaco/tab/\\n"];

    /* ============ identificador / instrucao (letra | _) ============ */
    qID [label="qID"];
    q0  -> qID     [label="letra | _"];
    qID -> qID     [label="letra | digito | _"];
    qID -> qID_FIM [label="delimitador\n(consulta tabela:\nINS_* ou ID)"];

    /* ================= diretiva (inicia com .) ================= */
    qDIR [label="qDIR"];
    q0   -> qDIR     [label="."];
    qDIR -> qDIR     [label="letra"];
    qDIR -> qDIR_FIM [label="delimitador\n(consulta tabela:\nDIR_* ou erro)"];

    /* ============== registrador (inicia com $) ============== */
    qREG [label="qREG"];
    q0   -> qREG     [label="$"];
    qREG -> qREG     [label="letra | digito"];
    qREG -> qREG_FIM [label="delimitador\n(consulta lista:\nREG ou erro)"];

    /* ===================== numero decimal ===================== */
    qNUM  [label="qNUM"];
    qZERO [label="qZERO\n(viu '0')"];
    q0    -> qNUM     [label="digito\n(1-9)"];
    q0    -> qZERO    [label="0"];
    qNUM  -> qNUM     [label="digito"];
    qZERO -> qNUM     [label="digito"];
    qNUM  -> qNUM_FIM [label="delimitador"];
    qZERO -> qNUM_FIM [label="delimitador"];

    /* ===================== numero hexadecimal ===================== */
    qHEXPRE [label="qHEXPRE\n(0x)"];
    qHEX    [label="qHEX"];
    qZERO   -> qHEXPRE [label="x | X"];
    qHEXPRE -> qHEX    [label="hexdigito"];
    qHEX    -> qHEX    [label="hexdigito"];
    qHEX    -> qHEX_FIM [label="delimitador"];
    qHEXPRE -> qERRO    [label="delimitador\n(sem hexdigito)"];

    /* ===================== numero negativo ===================== */
    qNEG [label="qNEG\n(viu '-')"];
    q0   -> qNEG [label="-"];
    qNEG -> qNUM  [label="digito (1-9)"];
    qNEG -> qZERO [label="0"];
    qNEG -> qERRO [label="delimitador\n(sem digito/0x)"];

    /* ===================== cadeia de caracteres ===================== */
    qSTR [label="qSTR"];
    qESC [label="qESC\n(depois de \\\\)"];
    q0   -> qSTR [label="\""];
    qSTR -> qSTR [label="qualquer,\nexceto \" \\\\ \\n EOF"];
    qSTR -> qESC [label="\\\\"];
    qESC -> qSTR [label="n | t | \" | \\\\ | 0\n(escape valido)"];
    qESC -> qERRO [label="outro\n(escape invalido,\nregistra erro e\nvolta a ler string)"];
    qERRO -> qSTR [label="(recuperacao)", style=dashed];
    qSTR -> qSTR_FIM      [label="\""];
    qSTR -> qERRO_STR_LINHA [label="\\n"];
    qSTR -> qERRO_STR_EOF   [label="EOF"];

    /* ===================== comentario ===================== */
    qCOM [label="qCOM"];
    q0   -> qCOM [label="#"];
    qCOM -> qCOM [label="qualquer,\nexceto \\n EOF"];
    qCOM -> q0   [label="\\n\n(sem token)"];
    qCOM -> q0   [label="EOF\n(sem token)"];

    /* ===================== simbolos de um caractere ===================== */
    qCOL_S [label="qCOL"];
    qOPA_S [label="qOPA"];
    qCPA_S [label="qCPA"];
    qCOM_S [label="qCOM_"];
    q0 -> qCOM_S [label=","];
    q0 -> qCOL_S [label=":"];
    q0 -> qOPA_S [label="("];
    q0 -> qCPA_S [label=")"];
    qCOM_S -> qCOM_FIM [label="SMB_COM"];
    qCOL_S -> qCOL_FIM [label="SMB_COL"];
    qOPA_S -> qOPA_FIM [label="SMB_OPA"];
    qCPA_S -> qCPA_FIM [label="SMB_CPA"];

    /* ===================== caractere invalido / EOF ===================== */
    q0 -> qERRO [label="qualquer outro\ncaractere\n(ERRO_CARACTERE_INVALIDO)"];
    q0 -> qEOF  [label="EOF\n(TK_EOF)"];
}
